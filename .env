# Environment Variables for App360

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production
ADMIN_PASSWORD=secure-admin-password

# Database
DATABASE_URL=postgresql://app360:secure_password@localhost:5432/app360

# Flask Environment
FLASK_ENV=production
DEBUG=False

# CORS
CORS_ORIGINS=https://vyp.app360.com.ar

# Frontend (for Vite)
VITE_API_BASE_URL=https://vyp.app360.com.ar/api

# Database Password (for docker-compose)
DB_PASSWORD=secure-db-password

# Server Configuration
SERVER_NAME=vyp.app360.com.ar
PREFERRED_URL_SCHEME=https

# Cookies (for production)
SESSION_COOKIE_SECURE=True
REMEMBER_COOKIE_SECURE=True

# UI
LOGIN_TITLE=Welcome to APP360