# App360: plantilla de configuracion (desarrollo local y Docker Compose).
#
# Uso:
#   1. Copiá este archivo a .env. El .env esta en .gitignore y no se versiona.
#   2. Reemplazá cada valor <...> por el tuyo. No dejes placeholders.
#   3. Generá las claves con: openssl rand -hex 32
#
# Ningún valor de este archivo es una credencial real.
# Las variables de produccion viven en el .env del servidor, no aca.

# --- Obligatorias: la app no arranca sin ellas ---

# Clave de firma de sesiones. Si no existe JWT_SECRET_KEY, los JWT usan esta.
SECRET_KEY=<generá-con-openssl-rand-hex-32>
# Clave inicial del usuario admin.
ADMIN_PASSWORD=<clave-inicial-del-admin>
# Conexion a PostgreSQL. La clave de la base va dentro de la URL.
DATABASE_URL=postgresql://app360:<clave-de-la-base>@localhost:5432/app360

# --- Solo para scripts/dev_backend.sh ---

# Clave del rol local app360, usada solo si el script crea el rol.
# Debe ser la misma clave que DATABASE_URL.
APP360_DB_PASSWORD=<misma-clave-que-DATABASE_URL>

# --- Opcionales ---

# Clave de firma de los JWT. Si se omite, la app usa SECRET_KEY.
# JWT_SECRET_KEY=<generá-con-openssl-rand-hex-32>
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
# Clave de la integracion de sincronizacion SabioGo (Windows Server).
SABIOGO_SYNC_API_KEY=<clave-de-la-integracion-sabiogo>

# --- Entorno y cookies (valores para desarrollo local) ---

FLASK_ENV=development
DEBUG=False
WTF_CSRF_ENABLED=True
PREFERRED_URL_SCHEME=http
SERVER_NAME=
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
LOGIN_TITLE="Welcome to APP360"

# --- Docker Compose (opcional) ---

# Clave del Postgres del contenedor db. Compose la usa en db y en la DATABASE_URL del servicio app.
DB_PASSWORD=<clave-del-postgres-del-contenedor>

# --- Presentes en el .env de produccion; el codigo actual no las lee ---

CORS_ORIGINS=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
