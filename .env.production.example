# Production Environment Variables for App360

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production
ADMIN_PASSWORD=admin-password

# Database
DATABASE_URL=postgresql://app360user:app360_secure@localhost:5432/app360

# Redis (Celery)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT & Security
JWT_SECRET=your-secret-key-here-change-in-production
API_KEY=dev-api-key-change-in-prod

# Flask Configuration
FLASK_ENV=production
DEBUG=False

# Server Configuration
SERVER_NAME=vyp.app360.com.ar
PREFERRED_URL_SCHEME=https

# Cookies (for production)
SESSION_COOKIE_SECURE=True
REMEMBER_COOKIE_SECURE=True

# CORS
CORS_ORIGINS=https://vyp.app360.com.ar

# UI
LOGIN_TITLE=Welcome to APP360